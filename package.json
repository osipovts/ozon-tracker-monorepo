{
  "name": "price-tracker-monorepo",
  "version": "1.2.4",
  "private": true,
  "description": "",
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm generate && pnpm -r test",
    "lint": "pnpm build:packages && pnpm generate && eslint .",
    "lint:fix": "pnpm build:packages && pnpm generate && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm -r --if-present generate",
    "test:e2e": "pnpm build:packages && pnpm generate && pnpm --filter frontend-admin build && pnpm --filter frontend-client build && pnpm --filter hub test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
