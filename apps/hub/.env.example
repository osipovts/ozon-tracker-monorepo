# Postgres from docker-compose.yml (user, password and database are `hub` by default).
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
PORT=3000
# How many of the best alive proxies a price fetch job may try.
PRICE_PROXY_COUNT=5
PRICE_TIMEOUT_MS=60000
# error, warn, info, debug or verbose (default).
LOG_LEVEL=verbose
