# Postgres from docker-compose.yml (user, password and database are `hub` by default).
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub
REDIS_URL=redis://localhost:6379
PORT=3000
# How many of the best alive proxies a price fetch job may try.
PRICE_PROXY_COUNT=5
PRICE_TIMEOUT_MS=60000
# The refresh of the prices runs every hour at this minute (UTC). A price must not be older than the maximum
# age: it is read at the last run before it would be, so an hour reads every price every hour. A run queues
# at most the batch of products. PRICE_REFRESH_INTERVAL_MS (milliseconds; 0 turns the refresh off) takes the
# place of the hourly schedule when it is set.
PRICE_REFRESH_MINUTE=55
PRICE_REFRESH_MAX_AGE_MS=3600000
PRICE_REFRESH_BATCH_SIZE=200
# The administrators of the hub, by email, comma separated: one is an administrator once the email is
# confirmed by mail. Administrators use the operator routes with their session, and the admin panel.
ADMIN_EMAILS=
# The built admin panel (`pnpm --filter frontend-admin build`, its `dist`), served at /panel; off when empty.
ADMIN_UI_DIR=
# The built client app (`pnpm --filter frontend-client build`, its `dist`), served at /app; off when empty.
CLIENT_UI_DIR=
# The API key of the operator (16 characters or more, `openssl rand -hex 32`); without it the
# routes of the proxies and the browser sessions stay closed. `pnpm sessions:onboard` needs the same.
HUB_API_KEY=
# How many reverse proxies stand in front of the hub (0 when clients reach it directly). Behind one,
# set it, or every client counts as the address of the proxy in the rate limits and the sessions.
TRUST_PROXY=0
# Where the hub is reached from outside: the providers send the user back to <PUBLIC_URL>/auth/oauth/<provider>/callback.
PUBLIC_URL=http://localhost:3000
# Where the user lands after a login through a provider: a path of the hub.
AUTH_SUCCESS_REDIRECT=/auth/me
# Login through Google and GitHub: the id and the secret of the OAuth app, both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Attempts per window (default 15 minutes): logins of one email from one address, logins of one email from
# all addresses (generous, so a stranger cannot lock the owner out), logins from one address, sign-ups from one address.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_MAX_ATTEMPTS_PER_EMAIL=100
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=50
AUTH_REGISTER_MAX_ATTEMPTS=5
# Origins besides PUBLIC_URL that may write to the hub, comma separated (e.g. a frontend on another origin).
AUTH_ALLOWED_ORIGINS=
# How often the sessions that ended (expired or revoked, a day ago or more) are deleted.
AUTH_SESSION_PURGE_INTERVAL_MS=3600000
# What a user may do with products: how many they track, how many they add per window.
PRODUCTS_PER_USER_MAX=100
PRODUCT_ADD_MAX_ATTEMPTS=30
PRODUCT_ADD_WINDOW_MS=3600000
# Mail: the SMTP service (smtp://user:password@host:587) and the sender. Without SMTP_URL the mails (the links
# to confirm an email) are written to the log, not sent.
SMTP_URL=
MAIL_FROM=Price Tracker <no-reply@localhost>
# How long the link to confirm an email works, and how many times a user may ask for it again per window.
EMAIL_VERIFICATION_TTL_MS=86400000
AUTH_VERIFICATION_RESEND_MAX_ATTEMPTS=3
# Login sessions: end after this long without use / after this long in all (default 14 and 30 days).
AUTH_SESSION_IDLE_TTL_MS=1209600000
AUTH_SESSION_ABSOLUTE_TTL_MS=2592000000
# Send the session cookie over HTTPS only; `false` for plain HTTP outside localhost.
AUTH_COOKIE_SECURE=true
# error, warn, info, debug or verbose (default).
LOG_LEVEL=verbose
# The S3 service that keeps the pictures of the products (in docker compose it is the `s3` service). Without an
# endpoint nothing is kept and the products show a placeholder. The public URL is where a browser reaches the
# service: the addresses of the pictures are signed for it.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_BUCKET=thumbnails
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
