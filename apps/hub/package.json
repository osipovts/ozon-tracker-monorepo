{
  "name": "hub",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.js"
  ],
  "scripts": {
    "generate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://localhost:5432/hub}\" prisma generate",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "pnpm generate && tsc && node --test \"dist/!(e2e)/**/*.test.js\"",
    "test:e2e": "pnpm generate && tsc && node --test \"dist/e2e/**/*.test.js\"",
    "start": "node dist/index.js",
    "dev": "node --watch --conditions=source --import @swc-node/register/esm-register src/index.ts",
    "migrate:deploy": "prisma migrate deploy",
    "openapi": "pnpm build && node dist/openapi.js ../frontend-admin/openapi.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.14.1",
    "playwright": "^1.64.1",
    "smtp-server": "^3.21.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.4.0",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "logger": "workspace:*",
    "nodemailer": "^10.3.1",
    "prisma": "7.10.1",
    "product-reference": "workspace:*",
    "queue-contract": "workspace:*",
    "queue-worker": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}
