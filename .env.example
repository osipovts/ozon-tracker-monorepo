# Read by docker compose (docker-compose.yml, docker-compose.dev.yml); the values are the defaults.
# Password of the `hub` user of Postgres; keep DATABASE_URL in apps/hub/.env in sync.
POSTGRES_PASSWORD=hub
# The API key of the operator of the hub (16 characters or more, `openssl rand -hex 32`): the routes
# of the proxies and the browser sessions are closed to everyone without it.
HUB_API_KEY=
# Login through Google and GitHub: the id and the secret of the OAuth app (both or neither), and
# where the hub is reached from outside (the callbacks are <PUBLIC_URL>/auth/oauth/<provider>/callback).
PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The administrators of the hub, by email, comma separated (confirmed by mail, they get the admin panel).
ADMIN_EMAILS=
# The built admin panel (`pnpm --filter frontend-admin build`, its `dist`), served at /panel; off when empty.
ADMIN_UI_DIR=
# The built client app (`pnpm --filter frontend-client build`, its `dist`), served at /app; off when empty.
CLIENT_UI_DIR=
# Mail: the SMTP service (smtp://user:password@host:587) and the sender. Without SMTP_URL the mails are
# written to the log of the hub, not sent.
SMTP_URL=
MAIL_FROM=Price Tracker <no-reply@localhost>
# Ports on this machine (reachable from it only).
HUB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
# error, warn, info, debug or verbose (default).
LOG_LEVEL=verbose
# Development only: the user of the containers, `uid:gid` of this machine; 0:0 for rootless Docker.
DEV_USER=1000:1000
